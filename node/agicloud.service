[Unit]
Description=AgiCloud
After=network-online.target
Wants=network-online.target

[Service]
User=agicloud
Group=agicloud
WorkingDirectory=/opt/agicloud
Environment=HOST=127.0.0.1
Environment=PORT=3095
Environment=TRUST_PROXY=1
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/agicloud
Environment=WORKSPACES_ROOT=/home/agicloud/progetti
Environment=PROJECT_ROOTS=/home/agicloud/progetti:/home/agicloud
Environment=PATH=/home/agicloud/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node --import tsx apps/server/src/index.ts
Restart=always
RestartSec=3
# I terminali (custodi staccati con setsid) restano vivi anche se AgiCloud si riavvia
KillMode=process

[Install]
WantedBy=multi-user.target
